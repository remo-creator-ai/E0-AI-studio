# =============================================================
#  프론트엔드(Vite) 런타임에서 실제로 읽는 값 — VITE_ 접두사 필수
#  (import.meta.env 로 노출됨 · 빌드에 인라인되므로 공개돼도 되는 값만)
# =============================================================

# Supabase (인증 & 프로젝트 저장 — 필수)
# Get from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 관리자 이메일 (isAdmin 판별용 — 필수)
VITE_ADMIN_EMAIL=your_admin_email_here

# 디자인(가계정) 모드 (선택)
#  - 미설정 + VITE_SUPABASE_URL 없음 → 자동 ON (가계정 버튼으로 화면 확인)
#  - 'false' → 강제 OFF (Supabase 실제 인증만 사용)
#  - 'true'  → 강제 ON (Supabase 설정돼 있어도 가계정 모드)
VITE_MOCK_AUTH=

# =============================================================
#  배포/서버 전용 (프론트에 인라인되지 않음)
# =============================================================

# Supabase Access Token (CLI deploy용)
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# Resend API Key (이메일 발송용 — Edge Function secret)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# =============================================================
#  ⚠️ Gemini / Kling API 키는 .env 로 설정하지 않습니다.
#  런타임에 Supabase `admin_config` 테이블에서 읽습니다
#  (services/adminConfigService.ts · 키: gemini_api_key,
#   kling_access_key_id, kling_access_key_secret).
#  관리자 콘솔(AdminPage)에서 입력·저장하세요.
# =============================================================
