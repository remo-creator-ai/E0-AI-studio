# Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (required for auth & project storage)
# Get from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Kling AI API Keys (required for Kling video engine)
# Get yours at: https://klingai.com/dev
KLING_ACCESS_KEY_ID=your_kling_access_key_id_here
KLING_ACCESS_KEY_SECRET=your_kling_access_key_secret_here

# Admin Email
VITE_ADMIN_EMAIL=your_admin_email_here

# Supabase Access Token (CLI deploy용)
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# Resend API Key (이메일 발송용 - Edge Function secret)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
