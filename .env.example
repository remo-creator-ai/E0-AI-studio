# E0 frontend - public values only
# Leave these blank for local preview. Use ONLY the new E0 Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_EMAIL=remoimagevideo@gmail.com

# Local development: auto-preview when Supabase is absent.
# Hosted review builds: explicitly true. Production: explicitly false.
VITE_MOCK_AUTH=

# Optional analytics - no previous project's measurement ID is used.
VITE_GA_MEASUREMENT_ID=

# CLI credentials belong in the local environment, never in this file or VITE_*.
# SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD, VERCEL_TOKEN
# Provider keys are entered in E0 admin_config or Supabase Edge Function secrets.
